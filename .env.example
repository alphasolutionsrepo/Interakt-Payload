DATABASE_URL=postgres://payload:payload@localhost:5433/payload
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public site URL, used for absolute URLs in Interakt documents
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Interakt ingestion (server-only). The key needs write + delete on the index.
INTERAKT_BASE_URL=http://localhost:3000
INTERAKT_INDEX_ID=
INTERAKT_INGESTION_KEY=

# Interakt experiences (public, read-only). Empty allowed-origins on an experience = any origin.
NEXT_PUBLIC_INTERAKT_BASE_URL=http://localhost:3000
NEXT_PUBLIC_INTERAKT_SEARCH_TOKEN=
NEXT_PUBLIC_INTERAKT_CHAT_TOKEN=
